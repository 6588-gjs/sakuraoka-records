# ---------------------------------------------------------------------------
# 行尾/二进制属性：保证 Linux CI 与 Windows 本地都能正确使用
# 关键点：gradlew 必须是 LF（否则 GitHub Actions 上 sh 报 $'\r': command not found）
# ---------------------------------------------------------------------------
* text=auto

gradlew          text eol=lf
gradlew.bat      text eol=crlf
*.sh             text eol=lf

*.jar            binary
*.png            binary
*.jpg            binary
*.jks            binary
*.keystore       binary
*.apk            binary
