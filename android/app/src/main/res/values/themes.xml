<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      游戏主题（Android 6.0+ / API 23+ 均可用）
      - 无 ActionBar、全屏、深色背景 #0B0B0B
      - 实际沉浸式隐藏系统栏由 MainActivity.hideSystemBars() 完成，
        主题里的 windowFullscreen / 颜色设置用于消除启动瞬间的白屏。
      后续如需更贴合 H5 风格（Win95 灰 / 藏青），可在此扩展。
    -->
    <style name="Theme.SakuraokaRecords.Base" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- 默认（API 23~27）主题 -->
    <style name="Theme.SakuraokaRecords" parent="Theme.SakuraokaRecords.Base" />
</resources>
